              "search_type": "Top"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_fill_topic",
        "difficulty": "medium",
        "what_it_tests": "Chủ đề bổ sung ở lượt 2, sắp xếp ở lượt 3 → social_search query=Claude, search_type=Top (không dùng timeline)."
      }
    },
    {
      "id": "G09_switch_web_to_twitter",
      "phase": "B",
      "suite": "group",
      "turns": [
