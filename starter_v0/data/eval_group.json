      },
      "metadata": {
        "skill": "multiturn_switch_tool_reverse",
        "difficulty": "hard",
        "what_it_tests": "Chiều ngược của M06: bỏ web chuyển sang Twitter → chỉ social_search, không gọi thừa lookup."
